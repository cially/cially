# The URL where the pocketbase instance is running on. DO NOT INCLUDE "/" AT THE END!
POCKETBASE_URL=your-pocketbase_url
POCKETBASE_ADMIN_EMAIL=your-pocketbase_email
POCKETBASE_ADMIN_PASSWORD=your-pocketbase_password

# The URL where the discord bot api instance is running on. DO NOT INCLUDE "/" AT THE END!
API_URL=your-api_url

# The name of pocketbase collections where data is being saved
# DO NOT CHANGE if you use the default pb_schema provided
MESSAGE_COLLECTION=messages
INVITE_COLLECTION=invites
MEMBER_LEAVES_COLLECTION=member_leaves
MEMBER_JOINS_COLLECTION=member_joins
GUILDS_COLLECTION=guilds
