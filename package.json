{
  "name": "cially",
  "version": "2.0.0-beta.0",
  "description": "OSS Discord Analytics",
  "type": "module",
  "scripts": {
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "docker:bot": "docker --target cially-bot -t cially-bot .",
    "docker:web": "docker --target cially-web -t cially-web .",
    "up": "taze -r -I",
    "lefthook": "lefthook install"
  },
  "dependencies": {
    "discord-api-types": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:dev",
    "lefthook": "catalog:dev",
    "taze": "catalog:dev",
    "turbo": "catalog:"
  },
  "packageManager": "pnpm@10.13.1"
}
