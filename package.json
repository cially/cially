{
  "name": "cially",
  "version": "2.0.0-beta.4",
  "description": "OSS Discord Analytics",
  "type": "module",
  "scripts": {
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "docker:bot": "docker buildx build -f ./apps/bot/Dockerfile -t ghcr.io/cially/bot:latest .",
    "docker:web": "docker buildx build -f ./apps/web/Dockerfile -t ghcr.io/cially/web:latest .",
    "docker:pb": "docker buildx build -f ./apps/pocketbase/Dockerfile -t ghcr.io/cially/pocketbase:latest ./apps/pocketbase",
    "up": "taze -r -I",
    "lefthook": "lefthook install"
  },
  "dependencies": {
    "discord-api-types": "catalog:",
    "express-rate-limit": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:dev",
    "lefthook": "catalog:dev",
    "taze": "catalog:dev",
    "turbo": "catalog:"
  },
  "packageManager": "pnpm@10.13.1"
}
