# Bot
TOKEN=
CLIENT_ID=
API_PORT=3001
API_URL=http://cially-bot:3001
DEBUGGING=FALSE # Change to TRUE to enable bot logs
GUILD_COLLECTION=guilds
MESSAGE_COLLECTION=messages
INVITE_COLLECTION=invites
MEMBER_LEAVES_COLLECTION=member_leaves
MEMBER_JOINS_COLLECTION=member_joins

# Website
PORT=3000

# Pocketbase
# Make sure to use your actual PocketBase URL (not a local/internal link). Example: http://your-domain:8090/
POCKETBASE_URL=
POCKETBASE_ADMIN_EMAIL=admin@cially.org
POCKETBASE_ADMIN_PASSWORD=admin123!
# Ensure this is a 32-character long encryption key https://pocketbase.io/docs/going-to-production/#enable-settings-encryption
# openssl rand -hex 16
POCKETBASE_ENCRYPTION_KEY=
